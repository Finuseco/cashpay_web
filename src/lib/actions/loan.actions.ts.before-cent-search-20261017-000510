export type LoanRepaymentFrequency = 'weekly' | 'monthly' | 'quarterly';

export interface LoanRepayment {
    id: number;
    amount: number;
    type: 'repayment' | 'penalty';
    payment_date: string;
    installment_number?: number;
    installment_numbers?: number[];
    allocations?: Array<{ installment_number: number; amount: number; remaining_amount: number }>;
    installment_remaining?: number;
    debt_remaining?: number;
}

export interface LoanInstallment {
    id: number;
    installment_number: number;
    due_date: string;
    amount: number;
    penalty: number;
    paid_amount: number;
    remaining_amount: number;
    status: 'pending' | 'partial' | 'overdue' | 'paid';
}

