}

export async function createBulkCardOrder(
    args: {
        cardProductToken: string;
        quantity: number;
    },
    token: string
) {
    return fyatuRequest(
        '/bulkissuances',
        'POST',
        {
            token,
            card_product_token:
                args.cardProductToken,
            quantity: args.quantity,
            fulfillment: {
                shipping_method: 'LOCAL_DELIVERY'
            }
        }
    );
}

export async function getBulkCardOrder(
    token: string
) {
    return fyatuRequest(
        `/bulkissuances/${token}`
    );
}

export async function listBulkCardOrders(
    count = 10
) {
    return fyatuRequest(
        '/bulkissuances',
        'GET',
        undefined,
        {
            queryParams: { count }
        }
    );
}

export async function getCardActivity(
    cardToken: string,
    count = 20
) {
    return fyatuRequest(
        `/cards/${cardToken}/activity`,
        'GET',
        undefined,
        {
            queryParams: { count }
        }
    );
}

export async function getCardActivityNetworkDetails(
    cardToken: string,
    activityToken: string
) {
    return fyatuRequest(
        `/cards/${cardToken}/activity/${activityToken}/networkdetails`
    );
}

export async function getProgramFundingBalances() {
    return fyatuRequest(
        '/fundingsources/program'
    );
}

export function formatJitResponse(
    jitToken: string,
    approve: boolean,
    amount: number,
    memo?: string
) {
    return {
        jit_funding: {
            token: jitToken,
            method: approve
                ? 'pgfs.authorization'
                : 'pgfs.decline',
            user_notified: true,
            memo:
                memo ||
                (
                    approve
                        ? 'Approved by CashPay All'
                        : 'Declined by CashPay All'
                )
        },
        response: {
            code: approve ? '0000' : '1001',
            memo: approve
                ? 'Success'
                : 'Insufficient Funds',
            amount
        }
    };
}
