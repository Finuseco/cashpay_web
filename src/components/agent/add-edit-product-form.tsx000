"use client";

import { useMemo, useRef, useState } from "react";
import Image from "next/image";
import {
  BookOpen,
  Check,
  FileAudio,
  FileText,
  ImagePlus,
  MapPin,
  Package,
  Plus,
  RefreshCw,
  ScanLine,
  Search,
  Trash2,
  Truck,
  UploadCloud,
  X,
  Loader2,
} from "lucide-react";
import { Button } from "@/components/ui/button";
import {
  Form,
  FormControl,
  FormDescription,
  FormField,
  FormItem,
  FormLabel,
  FormMessage,
} from "@/components/ui/form";
import { Input } from "@/components/ui/input";
import { Checkbox } from "../ui/checkbox";
import { Textarea } from "../ui/textarea";
import { QrScannerDialog } from "@/components/shared/qr-scanner-dialog";
import { zodResolver } from "@hookform/resolvers/zod";
import { useFieldArray, useForm } from "react-hook-form";
import { z } from "zod";
import type { Boutique, Product, ProductCategory } from "@/lib/types";
import { useToast } from "@/hooks/use-toast";

const productFormSchema = z.object({
  name: z.string().trim().min(3, "Le nom du produit doit contenir au moins 3 caractères."),
  description: z.string().optional(),
  categoryId: z.string().min(1, "Veuillez sélectionner une catégorie."),
  boutiqueId: z.string().min(1, "Veuillez sélectionner une boutique."),
  purchasePrice: z.coerce.number().min(0, "Le prix d'achat ne peut pas être négatif."),
  sellingPrice: z.coerce.number().min(0.01, "Le prix de vente est requis."),
  barcode: z.string().trim().min(1, "Le code-barres / SKU est requis."),
  images: z.array(z.string()).min(1, "Veuillez téléverser au moins une image.").max(5, "Vous pouvez téléverser 5 images maximum."),
  isPublic: z.boolean().default(false),
  weight: z.coerce.number().min(0, "Le poids ne peut pas être négatif."),
  stock: z.coerce.number().int().min(0, "Le stock doit être un nombre entier positif."),
  variations: z.array(z.object({
    color: z.string().trim().min(1, "La couleur est requise."),
    stock: z.coerce.number().int().min(0, "Le stock doit être positif."),
  })).min(1, "Ajoutez au moins une variation."),
  isbn10: z.string().optional(),
  isbn13: z.string().optional(),
  pdfUrl: z.string().optional(),
  sourceUrl: z.string().optional(),
  audioUrl: z.string().optional(),
});

type FormValues = z.infer<typeof productFormSchema>;

type ShippingRate = { country: string; province: string; rate: number };
type PromotionalPackage = { quantity: number; price: number };

type Props = {
  onFormSubmit: (p: Partial<Product>) => void | Promise<unknown>;
  categories: ProductCategory[];
  boutiques: Boutique[];
  initialData?: Product | null;
};


type RadioSearchOption = { value: string; label: string; description?: string };

function SearchableRadioGroup({
  label,
  value,
  onChange,
  options,
  placeholder,
  emptyText,
}: {
  label: string;
  value: string;
  onChange: (value: string) => void;
  options: RadioSearchOption[];
  placeholder: string;
  emptyText: string;
}) {
  const [query, setQuery] = useState("");
  const normalizedQuery = query.trim().toLocaleLowerCase();
  const filtered = options.filter((option) =>
    !normalizedQuery ||
    option.label.toLocaleLowerCase().includes(normalizedQuery) ||
    option.description?.toLocaleLowerCase().includes(normalizedQuery)
  );

  return (
    <div className="space-y-3 rounded-xl border border-white/10 bg-slate-900/50 p-3">
      <div className="flex items-center justify-between gap-3">
        <div>
          <p className="text-sm font-medium text-white">{label} *</p>
          <p className="text-[11px] text-slate-400">Sélectionnez une seule option.</p>
        </div>
        <span className="rounded-full border border-white/10 bg-white/5 px-2 py-1 text-[10px] text-slate-400">
          {options.length} disponible{options.length > 1 ? "s" : ""}
        </span>
      </div>

      {options.length > 6 && (
        <div className="relative">
          <Search className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-500" />
          <Input
            value={query}
            onChange={(event) => setQuery(event.target.value)}
            placeholder={placeholder}
            className="pl-9"
            aria-label={`Rechercher ${label.toLocaleLowerCase()}`}
          />
        </div>
      )}

      <div className="grid max-h-52 gap-2 overflow-y-auto pr-1 sm:grid-cols-2">
        {filtered.map((option) => (
          <label
            key={option.value}
            className={`flex cursor-pointer items-center gap-3 rounded-xl border p-3 transition-colors ${
              value === option.value
                ? "border-blue-500/70 bg-blue-500/10"
                : "border-white/10 bg-slate-950/40 hover:border-white/20"
            }`}
          >
            <input
              type="radio"
              name={label.replace(/\s+/g, "-").toLowerCase()}
              value={option.value}
              checked={value === option.value}
              onChange={() => onChange(option.value)}
              className="h-4 w-4 shrink-0 accent-blue-600"
            />
            <span className="min-w-0">
              <span className="block truncate text-sm font-medium text-white">{option.label}</span>
              {option.description && <span className="block truncate text-[11px] text-slate-500">{option.description}</span>}
            </span>
          </label>
        ))}
      </div>

      {filtered.length === 0 && (
        <p className="rounded-lg border border-dashed border-white/10 p-3 text-center text-xs text-slate-500">{emptyText}</p>
      )}
    </div>
  );
}

function parseShippingRates(value: unknown): ShippingRate[] {
  if (!Array.isArray(value)) return [];
  return value.map((item: any) => ({
    country: String(item?.country || "CD").toUpperCase(),
    province: String(item?.province || "").trim(),
    rate: Number(item?.rate || 0),
  })).filter((item) => item.province && Number.isFinite(item.rate) && item.rate >= 0);
}

function parsePromotionalPackages(value: unknown): PromotionalPackage[] {
  if (!Array.isArray(value)) return [];
  return value.map((item: any) => ({
    quantity: Math.max(1, Math.trunc(Number(item?.quantity || 1))),
    price: Math.max(0, Number(item?.price || 0)),
  })).filter((item) => Number.isFinite(item.quantity) && Number.isFinite(item.price));
}

const DRC_PROVINCES = [
  "Bas-Uele", "Équateur", "Haut-Katanga", "Haut-Lomami", "Haut-Uele", "Ituri",
  "Kasaï", "Kasaï-Central", "Kasaï-Oriental", "Kinshasa", "Kongo-Central", "Kwango",
  "Kwilu", "Lomami", "Lualaba", "Mai-Ndombe", "Maniema", "Mongala", "Nord-Kivu",
  "Nord-Ubangi", "Sankuru", "Sud-Kivu", "Sud-Ubangi", "Tanganyika", "Tshopo", "Tshuapa",
];

function generateInternalEan13() {
  const digits = `20${Array.from({ length: 10 }, () => Math.floor(Math.random() * 10)).join("")}`;
  const base = digits.slice(0, 12).split("").map(Number);
  const sum = base.reduce((total, digit, index) => total + digit * (index % 2 === 0 ? 1 : 3), 0);
  const check = (10 - (sum % 10)) % 10;
  return `${digits.slice(0, 12)}${check}`;
}

export function AddEditProductForm({ onFormSubmit, categories, boutiques, initialData }: Props) {
  const { toast } = useToast();
  const [isScannerOpen, setIsScannerOpen] = useState(false);
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [fileBusy, setFileBusy] = useState<string | null>(null);
  const fileInputRef = useRef<HTMLInputElement>(null);
  const pdfInputRef = useRef<HTMLInputElement>(null);
  const sourceInputRef = useRef<HTMLInputElement>(null);
  const audioInputRef = useRef<HTMLInputElement>(null);

  const initialDetails = ((initialData as any)?.details || {}) as Record<string, any>;
  const initialShipping = (initialData as any)?.shippingRates;
  const initialPromotions = (initialData as any)?.promotionalPackages;
  const [shippingRates, setShippingRates] = useState<ShippingRate[]>(() => parseShippingRates(initialShipping));
  const [promotionalPackages, setPromotionalPackages] = useState<PromotionalPackage[]>(() => parsePromotionalPackages(initialPromotions));
  const [shippingProvince, setShippingProvince] = useState("");
  const [shippingSearch, setShippingSearch] = useState("");
  const [shippingRate, setShippingRate] = useState(0);
  const [packageQuantity, setPackageQuantity] = useState(2);
  const [packagePrice, setPackagePrice] = useState(0);

  const form = useForm<FormValues>({
    resolver: zodResolver(productFormSchema),
    defaultValues: {
      name: initialData?.name || "",
      description: initialData?.description || "",
      categoryId: initialData?.categoryId || "",
      boutiqueId: initialData?.boutiqueId || "",
      purchasePrice: Number((initialData as any)?.purchasePrice ?? 0),
      sellingPrice: Number((initialData as any)?.sellingPrice ?? 0),
      barcode: initialData?.barcode || "",
      images: initialData?.images || [],
      isPublic: Boolean(initialData?.isPublic),
      weight: Number((initialData as any)?.weight ?? 0),
      stock: Number((initialData as any)?.stock ?? 0),
      variations:
        Array.isArray(initialData?.variations) && initialData!.variations!.length
          ? initialData!.variations!.map((v: any) => ({ color: String(v.color || "Unique"), stock: Number(v.stock || 0) }))
          : [{ color: "Unique", stock: Number((initialData as any)?.stock || 0) }],
      isbn10: String((initialData as any)?.isbn10 ?? initialDetails.isbn10 ?? ""),
      isbn13: String((initialData as any)?.isbn13 ?? initialDetails.isbn13 ?? ""),
      pdfUrl: String(initialDetails.pdfUrl ?? ""),
      sourceUrl: String(initialDetails.sourceUrl ?? ""),
      audioUrl: String(initialDetails.audioUrl ?? ""),
    },
  });

  const { fields, append, remove } = useFieldArray({ control: form.control, name: "variations" });
  const imagePreviews = form.watch("images");
  const categoryId = form.watch("categoryId");
  const isBook = categoryId === "cat-livre";

  const totalVariationStock = useMemo(
    () => fields.reduce((sum, _, index) => sum + Number(form.watch(`variations.${index}.stock`) || 0), 0),
    // eslint-disable-next-line react-hooks/exhaustive-deps
    [fields, form.watch("variations")]
  );

  const readFileAsDataUrl = (file: File) =>
    new Promise<string>((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(String(reader.result || ""));
      reader.onerror = () => reject(new Error("Impossible de lire le fichier."));
      reader.readAsDataURL(file);
    });

  const handleImageChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const files = Array.from(e.target.files || []);
    const remaining = Math.max(0, 5 - imagePreviews.length);
    files.slice(0, remaining).forEach((file) => {
      const reader = new FileReader();
      reader.onloadend = () => {
        const current = form.getValues("images") || [];
        if (current.length < 5) {
          form.setValue("images", [...current, String(reader.result || "")], { shouldValidate: true, shouldDirty: true });
        }
      };
      reader.readAsDataURL(file);
    });
    e.target.value = "";
  };

  const handleBookFile = async (
    e: React.ChangeEvent<HTMLInputElement>,
    fieldName: "pdfUrl" | "sourceUrl" | "audioUrl"
  ) => {
    const file = e.target.files?.[0];
    e.target.value = "";
    if (!file) return;
    setFileBusy(fieldName);
    try {
      const dataUrl = await readFileAsDataUrl(file);
      form.setValue(fieldName, dataUrl, { shouldDirty: true, shouldValidate: true });
    } finally {
      setFileBusy(null);
    }
  };

  const handleScanSuccess = (scannedText: string) => {
    form.setValue("barcode", scannedText, { shouldValidate: true, shouldDirty: true });
    setIsScannerOpen(false);
  };

  const addShippingRate = () => {
    const province = shippingProvince.trim();
    const rate = Number(shippingRate);
    if (!province || !Number.isFinite(rate) || rate < 0) return;
    setShippingRates((current) => {
      const existing = current.findIndex((item) => item.country === "CD" && item.province === province);
      const next = { country: "CD", province, rate };
      if (existing >= 0) return current.map((item, index) => index === existing ? next : item);
      return [...current, next];
    });
    setShippingProvince("");
    setShippingRate(0);
  };

  const addPromotionalPackage = () => {
    const quantity = Math.trunc(Number(packageQuantity));
    const price = Number(packagePrice);
    if (!Number.isFinite(quantity) || quantity < 1 || !Number.isFinite(price) || price < 0) return;
    setPromotionalPackages((current) => [...current, { quantity, price }]);
    setPackageQuantity(2);
    setPackagePrice(0);
  };

  const submit = async (values: FormValues) => {
    if (isSubmitting) return;

    setIsSubmitting(true);
    form.clearErrors("root");

    try {
      const details = {
        ...initialDetails,
        isbn10: values.isbn10?.trim() || undefined,
        isbn13: values.isbn13?.trim() || undefined,
        ...(isBook
          ? {
              pdfUrl: values.pdfUrl || undefined,
              sourceUrl: values.sourceUrl || undefined,
              audioUrl: values.audioUrl || undefined,
            }
          : {}),
      };

      const payload: Partial<Product> = {
        ...(initialData || {}),
        name: values.name.trim(),
        description: values.description?.trim() || "",
        categoryId: values.categoryId,
        boutiqueId: values.boutiqueId,
        purchasePrice: values.purchasePrice,
        sellingPrice: values.sellingPrice,
        barcode: values.barcode.trim(),
        images: values.images,
        isPublic: Boolean(values.isPublic),
        weight: values.weight,
        stock: values.stock,
        variations: values.variations.map((v) => ({
          color: v.color.trim(),
          stock: Number(v.stock),
        })),
        shippingRates: shippingRates.length ? shippingRates : null,
        promotionalPackages: promotionalPackages.length ? promotionalPackages : null,
        details,
        isbn10: values.isbn10?.trim() || undefined,
        isbn13: values.isbn13?.trim() || undefined,
      };

      const result = await onFormSubmit(payload);

      if (
        result &&
        typeof result === "object" &&
        "success" in result &&
        (result as any).success === false
      ) {
        throw new Error(
          (result as any).error || "La publication n'a pas pu être enregistrée."
        );
      }
    } catch (error: any) {
      const message =
        error?.message ||
        "La publication n'a pas pu être enregistrée. Veuillez réessayer.";
      form.setError("root", { message });
      toast({
        title: "Échec de la publication",
        description: message,
        variant: "destructive",
      });
    } finally {
      setIsSubmitting(false);
    }
  };

  const invalidSubmit = (errors: Record<string, any>) => {
    const firstError = Object.values(errors).find(
      (error: any) => error?.message
    );
    const message =
      firstError?.message ||
      "Veuillez compléter les informations obligatoires avant de publier.";
    form.setError("root", { message });
    toast({
      title: "Informations manquantes",
      description: message,
      variant: "destructive",
    });
  };

  const selectedBoutique = boutiques.find((b: any) => String(b.id) === form.watch("boutiqueId"));
  const selectedCategory = categories.find((c: any) => String(c.id) === categoryId);

  return (
    <>
      <QrScannerDialog
        open={isScannerOpen}
        onOpenChange={setIsScannerOpen}
        onScanSuccess={handleScanSuccess}
        mode="barcode"
      />

      <div className="w-full max-h-[70vh] overflow-y-auto overflow-x-hidden pr-1 sm:pr-2">
        <Form {...form}>
          <form onSubmit={form.handleSubmit(submit, invalidSubmit)} noValidate className="space-y-5 pb-2">
            <div className="rounded-2xl border border-white/10 bg-slate-950/80 p-4 shadow-xl sm:p-5">
              <div className="mb-4 flex items-center justify-between gap-3">
                <div>
                  <p className="text-sm font-semibold text-white">Images du produit</p>
                  <p className="text-xs text-slate-400">Jusqu'à 5 images • la première sera l'image principale.</p>
                </div>
                <ImagePlus className="h-5 w-5 text-blue-400" />
              </div>

              <FormField control={form.control} name="images" render={() => (
                <FormItem>
                  <div className="grid grid-cols-3 gap-2 sm:grid-cols-5">
                    {imagePreviews.map((src, index) => (
                      <div key={`${src}-${index}`} className="group relative aspect-square overflow-hidden rounded-xl border border-white/10 bg-slate-900">
                        <Image src={src} alt={`Produit ${index + 1}`} fill unoptimized className="object-cover" />
                        <button
                          type="button"
                          aria-label="Supprimer l'image"
                          onClick={() => form.setValue("images", imagePreviews.filter((_, i) => i !== index), { shouldValidate: true, shouldDirty: true })}
                          className="absolute right-1.5 top-1.5 rounded-full bg-red-600 p-1.5 text-white shadow-lg"
                        >
                          <X className="h-3.5 w-3.5" />
                        </button>
                        {index === 0 && <span className="absolute bottom-1.5 left-1.5 rounded-full bg-black/70 px-2 py-0.5 text-[10px] font-semibold text-white">Principale</span>}
                      </div>
                    ))}
                    {imagePreviews.length < 5 && (
                      <button
                        type="button"
                        onClick={() => fileInputRef.current?.click()}
                        className="flex aspect-square flex-col items-center justify-center rounded-xl border-2 border-dashed border-blue-500/40 bg-blue-500/5 text-slate-400 transition-colors hover:border-blue-400 hover:bg-blue-500/10"
                      >
                        <UploadCloud className="h-6 w-6 text-blue-400" />
                        <span className="mt-1 text-[10px]">Ajouter</span>
                      </button>
                    )}
                  </div>
                  <input ref={fileInputRef} type="file" className="hidden" accept="image/*" multiple onChange={handleImageChange} />
                  <FormMessage />
                </FormItem>
              )} />
            </div>

            <div className="rounded-2xl border border-white/10 bg-slate-950/80 p-4 shadow-xl sm:p-5">
              <div className="mb-4 flex items-center gap-3">
                <div className="rounded-lg bg-blue-500/10 p-2 text-blue-400"><Check className="h-4 w-4" /></div>
                <div>
                  <p className="text-sm font-semibold text-white">Informations générales</p>
                  <p className="text-xs text-slate-400">Le produit est rattaché à la boutique choisie.</p>
                </div>
              </div>

              <div className="grid gap-4 md:grid-cols-2">
                <FormField control={form.control} name="name" render={({ field }) => (
                  <FormItem className="md:col-span-2">
                    <FormLabel>Nom du produit *</FormLabel>
                    <FormControl><Input {...field} placeholder="Ex. Smartphone CashPay X1" /></FormControl>
                    <FormMessage />
                  </FormItem>
                )} />

                <FormField control={form.control} name="description" render={({ field }) => (
                  <FormItem className="md:col-span-2">
                    <FormLabel>Description</FormLabel>
                    <FormControl><Textarea {...field} placeholder="Décrivez le produit, ses caractéristiques et son contenu..." className="min-h-28 resize-y" /></FormControl>
                    <FormMessage />
                  </FormItem>
                )} />

                <FormField control={form.control} name="boutiqueId" render={({ field }) => (
                  <FormItem className="md:col-span-2">
                    <FormControl>
                      <SearchableRadioGroup
                        label="Boutique"
                        value={field.value}
                        onChange={field.onChange}
                        options={boutiques.map((boutique: any) => ({
                          value: String(boutique.id),
                          label: String(boutique.name || `Boutique ${boutique.id}`),
                          description: boutique.description ? String(boutique.description) : undefined,
                        }))}
                        placeholder="Rechercher une boutique..."
                        emptyText="Aucune boutique ne correspond à votre recherche."
                      />
                    </FormControl>
                    <FormDescription>{selectedBoutique ? `Boutique sélectionnée : ${selectedBoutique.name}` : "Chaque produit doit appartenir à une boutique."}</FormDescription>
                    <FormMessage />
                  </FormItem>
                )} />

                <FormField control={form.control} name="categoryId" render={({ field }) => (
                  <FormItem className="md:col-span-2">
                    <FormControl>
                      <SearchableRadioGroup
                        label="Catégorie"
                        value={field.value}
                        onChange={field.onChange}
                        options={categories.map((category: any) => ({
                          value: String(category.id),
                          label: String(category.name || `Catégorie ${category.id}`),
                        }))}
                        placeholder="Rechercher une catégorie..."
                        emptyText="Aucune catégorie ne correspond à votre recherche."
                      />
                    </FormControl>
                    <FormDescription>{selectedCategory?.name || "Choisissez la catégorie du produit."}</FormDescription>
                    <FormMessage />
                  </FormItem>
                )} />

                <FormField control={form.control} name="barcode" render={({ field }) => (
                  <FormItem className="md:col-span-2">
                    <FormLabel>Code-barres / SKU *</FormLabel>
                    <div className="grid gap-2 sm:grid-cols-[1fr_auto_auto]">
                      <FormControl><Input {...field} inputMode="numeric" placeholder="Scannez, saisissez ou générez le code" /></FormControl>
                      <Button type="button" variant="outline" onClick={() => setIsScannerOpen(true)} aria-label="Scanner le code-barres">
                        <ScanLine className="mr-1.5 h-4 w-4" />Scanner
                      </Button>
                      <Button type="button" variant="outline" onClick={() => form.setValue("barcode", generateInternalEan13(), { shouldValidate: true, shouldDirty: true })}>
                        <RefreshCw className="mr-1.5 h-4 w-4" />Générer
                      </Button>
                    </div>
                    <FormDescription>Vous pouvez scanner un code existant ou générer un code interne EAN-13 pour ce produit.</FormDescription>
                    <FormMessage />
                  </FormItem>
                )} />
              </div>
            </div>

            <div className="rounded-2xl border border-white/10 bg-slate-950/80 p-4 shadow-xl sm:p-5">
              <p className="mb-4 text-sm font-semibold text-white">Prix, stock et logistique</p>
              <div className="grid gap-4 sm:grid-cols-2">
                <FormField control={form.control} name="purchasePrice" render={({ field }) => (
                  <FormItem><FormLabel>Prix d'achat</FormLabel><FormControl><Input {...field} type="number" min="0" step="0.01" placeholder="0.00" /></FormControl><FormMessage /></FormItem>
                )} />
                <FormField control={form.control} name="sellingPrice" render={({ field }) => (
                  <FormItem><FormLabel>Prix de vente *</FormLabel><FormControl><Input {...field} type="number" min="0.01" step="0.01" placeholder="0.00" /></FormControl><FormMessage /></FormItem>
                )} />
                <FormField control={form.control} name="stock" render={({ field }) => (
                  <FormItem><FormLabel>Stock total *</FormLabel><FormControl><Input {...field} type="number" min="0" step="1" /></FormControl><FormDescription>{totalVariationStock > 0 ? `Stock indiqué dans les variations : ${totalVariationStock}` : "Stock disponible à la vente."}</FormDescription><FormMessage /></FormItem>
                )} />
                <FormField control={form.control} name="weight" render={({ field }) => (
                  <FormItem><FormLabel>Poids</FormLabel><FormControl><Input {...field} type="number" min="0" step="0.01" placeholder="0.00" /></FormControl><FormDescription>Poids utilisé pour la logistique, si nécessaire.</FormDescription><FormMessage /></FormItem>
                )} />
              </div>
            </div>

            <div className="rounded-2xl border border-white/10 bg-slate-950/80 p-4 shadow-xl sm:p-5">
              <div className="mb-4 flex items-center justify-between">
                <div><p className="text-sm font-semibold text-white">Variations / stock par couleur</p><p className="text-xs text-slate-400">Ajoutez les variantes disponibles et leur stock.</p></div>
                <Button type="button" variant="outline" size="sm" onClick={() => append({ color: "", stock: 0 })}><Plus className="mr-1.5 h-4 w-4" />Ajouter</Button>
              </div>
              <div className="space-y-3">
                {fields.map((item, index) => (
                  <div key={item.id} className="grid gap-3 rounded-xl border border-white/10 bg-slate-900/60 p-3 sm:grid-cols-[1fr_180px_auto] sm:items-end">
                    <FormField control={form.control} name={`variations.${index}.color`} render={({ field }) => (
                      <FormItem><FormLabel>Couleur / variante</FormLabel><FormControl><Input {...field} placeholder="Unique, Noir, Bleu..." /></FormControl><FormMessage /></FormItem>
                    )} />
                    <FormField control={form.control} name={`variations.${index}.stock`} render={({ field }) => (
                      <FormItem><FormLabel>Stock</FormLabel><FormControl><Input {...field} type="number" min="0" step="1" /></FormControl><FormMessage /></FormItem>
                    )} />
                    <Button type="button" variant="ghost" size="icon" onClick={() => remove(index)} disabled={fields.length === 1} aria-label="Supprimer la variation"><Trash2 className="h-4 w-4 text-red-400" /></Button>
                  </div>
                ))}
              </div>
            </div>

            {isBook && (
              <div className="rounded-2xl border border-blue-500/20 bg-blue-500/5 p-4 shadow-xl sm:p-5">
                <div className="mb-4 flex items-center gap-3">
                  <div className="rounded-lg bg-blue-500/10 p-2 text-blue-400"><BookOpen className="h-5 w-5" /></div>
                  <div><p className="text-sm font-semibold text-white">Informations du livre</p><p className="text-xs text-slate-400">Ajoutez les informations complémentaires du livre, si nécessaire.</p></div>
                </div>
                <div className="grid gap-4 sm:grid-cols-2">
                  <FormField control={form.control} name="isbn10" render={({ field }) => <FormItem><FormLabel>ISBN-10</FormLabel><FormControl><Input {...field} placeholder="ISBN-10" /></FormControl><FormMessage /></FormItem>} />
                  <FormField control={form.control} name="isbn13" render={({ field }) => <FormItem><FormLabel>ISBN-13</FormLabel><FormControl><Input {...field} placeholder="ISBN-13" /></FormControl><FormMessage /></FormItem>} />

                  <FormField control={form.control} name="pdfUrl" render={({ field }) => (
                    <FormItem className="sm:col-span-2"><FormLabel>PDF du livre</FormLabel><div className="flex gap-2"><FormControl><Input {...field} placeholder="URL existante ou fichier PDF" /></FormControl><Button type="button" variant="outline" onClick={() => pdfInputRef.current?.click()} disabled={fileBusy === "pdfUrl"}>{fileBusy === "pdfUrl" ? "Lecture..." : <><FileText className="mr-1.5 h-4 w-4" />PDF</>}</Button></div><FormDescription>Ajoutez le fichier PDF du livre ou indiquez son adresse.</FormDescription><FormMessage /></FormItem>
                  )} />
                  <input ref={pdfInputRef} type="file" className="hidden" accept="application/pdf,.pdf" onChange={(e) => handleBookFile(e, "pdfUrl")} />

                  <FormField control={form.control} name="sourceUrl" render={({ field }) => (
                    <FormItem className="sm:col-span-2"><FormLabel>Source / document maître</FormLabel><div className="flex gap-2"><FormControl><Input {...field} placeholder="URL existante ou fichier" /></FormControl><Button type="button" variant="outline" onClick={() => sourceInputRef.current?.click()} disabled={fileBusy === "sourceUrl"}>{fileBusy === "sourceUrl" ? "Lecture..." : <><UploadCloud className="mr-1.5 h-4 w-4" />Source</>}</Button></div><FormDescription>Ajoutez le document source du livre, si vous en disposez.</FormDescription><FormMessage /></FormItem>
                  )} />
                  <input ref={sourceInputRef} type="file" className="hidden" onChange={(e) => handleBookFile(e, "sourceUrl")} />

                  <FormField control={form.control} name="audioUrl" render={({ field }) => (
                    <FormItem className="sm:col-span-2"><FormLabel>Audio du livre</FormLabel><div className="flex gap-2"><FormControl><Input {...field} placeholder="URL existante ou fichier audio" /></FormControl><Button type="button" variant="outline" onClick={() => audioInputRef.current?.click()} disabled={fileBusy === "audioUrl"}>{fileBusy === "audioUrl" ? "Lecture..." : <><FileAudio className="mr-1.5 h-4 w-4" />Audio</>}</Button></div><FormDescription>Ajoutez le fichier audio du livre, si disponible.</FormDescription><FormMessage /></FormItem>
                  )} />
                  <input ref={audioInputRef} type="file" className="hidden" accept="audio/*" onChange={(e) => handleBookFile(e, "audioUrl")} />
                </div>
              </div>
            )}

            <div className="grid gap-5 lg:grid-cols-2">
              <div className="rounded-2xl border border-white/10 bg-slate-950/80 p-4 shadow-xl sm:p-5">
                <div className="mb-4 flex items-center gap-3">
                  <div className="rounded-lg bg-blue-500/10 p-2 text-blue-400"><Truck className="h-5 w-5" /></div>
                  <div><p className="text-sm font-semibold text-white">Livraison</p><p className="text-xs text-slate-400">Définissez le prix de livraison par province.</p></div>
                </div>
                <div className="space-y-3">
                  <div className="relative">
                    <Search className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-500" />
                    <Input value={shippingSearch} onChange={(e) => setShippingSearch(e.target.value)} placeholder="Rechercher une province..." className="pl-9" />
                  </div>
                  <div className="max-h-36 space-y-1 overflow-y-auto rounded-xl border border-white/10 bg-slate-900/50 p-2">
                    {DRC_PROVINCES.filter((province) => province.toLocaleLowerCase().includes(shippingSearch.trim().toLocaleLowerCase())).map((province) => (
                      <label key={province} className={`flex cursor-pointer items-center gap-3 rounded-lg p-2.5 ${shippingProvince === province ? "bg-blue-500/10 text-white" : "text-slate-300 hover:bg-white/5"}`}>
                        <input type="radio" name="shipping-province" value={province} checked={shippingProvince === province} onChange={() => setShippingProvince(province)} className="h-4 w-4 accent-blue-600" />
                        <MapPin className="h-4 w-4 shrink-0 text-slate-500" />
                        <span className="text-sm">{province}</span>
                      </label>
                    ))}
                  </div>
                  <div className="grid grid-cols-[1fr_auto] gap-2">
                    <Input type="number" min="0" step="0.01" value={shippingRate} onChange={(e) => setShippingRate(Number(e.target.value))} placeholder="Prix de livraison" />
                    <Button type="button" variant="outline" onClick={addShippingRate} disabled={!shippingProvince}><Plus className="mr-1.5 h-4 w-4" />Ajouter</Button>
                  </div>
                  <div className="space-y-2">
                    {shippingRates.length === 0 ? <p className="rounded-lg border border-dashed border-white/10 p-3 text-center text-xs text-slate-500">Aucun tarif défini. La livraison reste facultative.</p> : shippingRates.map((item, index) => (
                      <div key={`${item.province}-${index}`} className="flex items-center justify-between gap-3 rounded-xl border border-white/10 bg-slate-900/60 p-3">
                        <div className="flex min-w-0 items-center gap-2"><MapPin className="h-4 w-4 shrink-0 text-blue-400" /><span className="truncate text-sm text-white">{item.province}</span></div>
                        <div className="flex items-center gap-2"><span className="text-sm font-semibold text-white">{item.rate.toFixed(2)}</span><Button type="button" variant="ghost" size="icon" onClick={() => setShippingRates((current) => current.filter((_, i) => i !== index))} aria-label={`Supprimer ${item.province}`}><Trash2 className="h-4 w-4 text-red-400" /></Button></div>
                      </div>
                    ))}
                  </div>
                </div>
              </div>

              <div className="rounded-2xl border border-white/10 bg-slate-950/80 p-4 shadow-xl sm:p-5">
                <div className="mb-4 flex items-center gap-3">
                  <div className="rounded-lg bg-blue-500/10 p-2 text-blue-400"><Package className="h-5 w-5" /></div>
                  <div><p className="text-sm font-semibold text-white">Offres promotionnelles</p><p className="text-xs text-slate-400">Créez des prix pour plusieurs unités du même produit.</p></div>
                </div>
                <div className="grid gap-2 sm:grid-cols-[110px_1fr_auto]">
                  <Input type="number" min="1" step="1" value={packageQuantity} onChange={(e) => setPackageQuantity(Number(e.target.value))} placeholder="Quantité" />
                  <Input type="number" min="0" step="0.01" value={packagePrice} onChange={(e) => setPackagePrice(Number(e.target.value))} placeholder="Prix du pack" />
                  <Button type="button" variant="outline" onClick={addPromotionalPackage}><Plus className="mr-1.5 h-4 w-4" />Ajouter</Button>
                </div>
                <div className="mt-3 space-y-2">
                  {promotionalPackages.length === 0 ? <p className="rounded-lg border border-dashed border-white/10 p-3 text-center text-xs text-slate-500">Aucune offre promotionnelle. Cette section est facultative.</p> : promotionalPackages.map((item, index) => (
                    <div key={`${item.quantity}-${item.price}-${index}`} className="flex items-center justify-between gap-3 rounded-xl border border-white/10 bg-slate-900/60 p-3">
                      <div><p className="text-sm font-semibold text-white">{item.quantity} unité{item.quantity > 1 ? "s" : ""}</p><p className="text-xs text-slate-500">Offre groupée</p></div>
                      <div className="flex items-center gap-2"><span className="text-sm font-semibold text-white">{item.price.toFixed(2)}</span><Button type="button" variant="ghost" size="icon" onClick={() => setPromotionalPackages((current) => current.filter((_, i) => i !== index))} aria-label="Supprimer l'offre"><Trash2 className="h-4 w-4 text-red-400" /></Button></div>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <div className="rounded-2xl border border-white/10 bg-slate-950/80 p-4 shadow-xl sm:p-5">
              <FormField control={form.control} name="isPublic" render={({ field }) => (
                <FormItem className="flex flex-row items-center justify-between gap-4 rounded-xl border border-white/10 bg-slate-900/60 p-4">
                  <div><FormLabel className="text-sm font-semibold">Publier dans Dojo Shopping</FormLabel><FormDescription>Le produit sera visible et disponible dans Dojo Shopping.</FormDescription></div>
                  <FormControl><Checkbox checked={field.value} onCheckedChange={field.onChange} /></FormControl>
                </FormItem>
              )} />
              {form.formState.errors.root?.message && <p className="mt-3 rounded-lg border border-red-500/20 bg-red-500/10 p-3 text-sm text-red-300">{form.formState.errors.root.message}</p>}
            </div>

            <Button
              type="submit"
              variant="gradient"
              className="h-12 w-full rounded-xl text-base font-bold shadow-lg"
              disabled={isSubmitting || !!fileBusy}
              aria-busy={isSubmitting}
            >
              {isSubmitting ? (
                <>
                  <Loader2 className="mr-2 h-5 w-5 animate-spin" />
                  {initialData ? "Enregistrement..." : "Publication en cours..."}
                </>
              ) : (
                <>
                  <Check className="mr-2 h-5 w-5" />
                  {initialData ? "Enregistrer les modifications" : "Publier le produit"}
                </>
              )}
            </Button>
          </form>
        </Form>
      </div>
    </>
  );
}
