
'use client';

import * as React from 'react';
import { useState, useMemo, useCallback } from 'react';
import { useRouter } from 'next/navigation';
import { useTranslation } from 'react-i18next';
import { Loader2 } from 'lucide-react';

import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import { Label } from '@/components/ui/label';
import { RadioGroup, RadioGroupItem } from '@/components/ui/radio-group';
import { Input } from '@/components/ui/input';
import { DepositStatusDialog } from './deposit-status-dialog';

import { MobileMoneyDepositForm } from './mobile-money-deposit-form';
import { CardDepositForm } from './card-deposit-form';
import { PaypalDepositForm } from './paypal-deposit-form';

import { africanCountries, internationalMethods } from '@/lib/payment-methods';
import { initiateDeposit, initiateCardDeposit, checkDepositStatus } from '@/lib/actions/deposit.actions';
import { getFee } from '@/lib/actions/fees.actions';
import { useToast } from '@/hooks/use-toast';
import type { User } from '@/lib/types';
import { countryToCode, getCountryByCode } from '@/lib/utils';

interface DepositClientProps {
  user: User;
}

export function DepositClient({ user }: DepositClientProps) {
  const { t } = useTranslation();
  const { toast } = useToast();
  const router = useRouter();

  const [searchTerm, setSearchTerm] = useState('');
  const [selectedMethod, setSelectedMethod] = useState<string>('');

  const [isLoading, setIsLoading] = useState(false);
  const [isPolling, setIsPolling] = useState(false);
  const [transactionRef, setTransactionRef] = useState<string | null>(null);
  const [status, setStatus] = useState<'pending' | 'success' | 'failed' | null>(null);
  const [statusMessage, setStatusMessage] = useState('');

  // Déterminer le code pays de l'utilisateur pour la priorisation
  const userCountryCode = useMemo(() => countryToCode(user.country), [user.country]);

  // Trier les pays pour afficher celui de l'utilisateur en premier
  const sortedCountries = useMemo(() => {
    if (!userCountryCode) return africanCountries;
    const sorted = [...africanCountries];
    sorted.sort((a, b) => {
      if (a.code === userCountryCode) return -1;
      if (b.code === userCountryCode) return 1;
      return a.name.localeCompare(b.name);
    });
    return sorted;
  }, [userCountryCode]);

  // Filtrer les sections selon la recherche (Locale uniquement)
  const filteredSections = useMemo(() => {
    const allSections = [
      ...sortedCountries.map(c => ({ ...c, type: 'country', id: c.code })),
      { ...internationalMethods, type: 'international', id: 'international' },
    ];

    if (!searchTerm) return allSections;

    return allSections.filter(section =>
      section.name.toLowerCase().includes(searchTerm.toLowerCase())
    );
  }, [searchTerm, sortedCountries]);

  const pollDepositStatus = useCallback(async (reference: string) => {
    setIsPolling(true);
    let attempts = 0;
    const maxAttempts = 12; // Polling pendant 1 minute (12 * 5s)

    const check = async () => {
      if (attempts >= maxAttempts) {
        setIsPolling(false);
        setStatus('failed');
        setStatusMessage(t('depositStatusTimeout', 'Délai de vérification dépassé. Veuillez vérifier votre solde dans quelques instants.'));
        return;
      }

      try {
        const result = await checkDepositStatus(reference);
        if (result.success && result.status === 'Completed') {
          setIsPolling(false);
          setStatus('success');
          setStatusMessage(t('depositStatusSuccessDesc'));
        } else if (result.status === 'Failed') {
          setIsPolling(false);
          setStatus('failed');
          setStatusMessage(result.message || t('depositStatusFailedTitle'));
        } else {
          attempts++;
          setTimeout(check, 5000);
        }
      } catch (error) {
        setIsPolling(false);
        setStatus('failed');
      }
    };

    check();
  }, [t]);

  const handleFormSubmit = async (data: any) => {
    if (!selectedMethod || !user.country) return;

    setIsLoading(true);
    try {
      // Déterminer la méthode et le pays pour le calcul des frais
      let paymentMethodForBackend: string;
      let countryForBackend: string;

      if (selectedMethod === 'Carte bancaire' || selectedMethod === 'PayPal') {
        paymentMethodForBackend = selectedMethod === 'Carte bancaire' ? 'card' : 'paypal';
        countryForBackend = userCountryCode || '';
      } else {
        // Format est "CODE:OPERATEUR"
        const [countryCode, methodName] = selectedMethod.split(':');
        paymentMethodForBackend = methodName;
        countryForBackend = countryCode;
      }

      if (!countryForBackend) throw new Error('Impossible de déterminer le pays.');

      // 1. Calcul des frais (Appel serveur unique)
      const feeResult = await getFee({
        amount: data.amount,
        currency: data.currency,
        country: countryForBackend,
        type: 'DEPOSIT',
        method: paymentMethodForBackend
      });

      if (!feeResult.success) throw new Error(feeResult.error || 'Erreur lors du calcul des frais.');

      const totalWithFee = feeResult.total || data.amount;

      // 2. Initiation du dépôt
      let result;
      if (paymentMethodForBackend === 'card') {
        result = await initiateCardDeposit({ ...data, user, totalAmount: totalWithFee });
      } else {
        result = await initiateDeposit({ ...data, user, totalAmount: totalWithFee, paymentMethod: paymentMethodForBackend });
      }

      if (result.success && result.transactionId) {
        setTransactionRef(result.transactionId);
        setStatus('pending');
        setStatusMessage(result.message || t('depositStatusInitiated'));
        pollDepositStatus(result.transactionId);
      } else {
        throw new Error(result.error || t('errorInternal'));
      }
    } catch (error: any) {
      toast({ title: t('error'), description: error.message, variant: 'destructive' });
    } finally {
      setIsLoading(false);
    }
  };

  const renderForm = () => {
    if (!selectedMethod) return null;

    const commonProps = {
      user,
      onSubmit: handleFormSubmit,
      isSubmitting: isLoading,
    };

    if (selectedMethod === 'Carte bancaire') {
      return <CardDepositForm {...commonProps} />;
    }
    if (selectedMethod === 'PayPal') {
      return <PaypalDepositForm {...commonProps} />;
    }
    if (selectedMethod.includes(':')) {
      const [countryCode] = selectedMethod.split(':');
      const country = getCountryByCode(countryCode);
      if (country) {
        return <MobileMoneyDepositForm {...commonProps} country={country} />;
      }
    }
    return null;
  };

  return (
    <>
      <Card className="border-none shadow-sm overflow-hidden">
        <CardHeader className="bg-muted/30 border-b">
          <CardTitle>{t('depositTitle', 'Approvisionnement')}</CardTitle>
          <CardDescription>{t('depositDescription', 'Ajoutez des fonds en toute sécurité à votre portefeuille.')}</CardDescription>
        </CardHeader>
        <CardContent className="pt-6">
          <div className="space-y-6">
            {/* Recherche locale de pays */}
            <Input
              placeholder={t('depositSearchPlaceholder', 'Rechercher un pays...')}
              value={searchTerm}
              onChange={(e) => setSearchTerm(e.target.value)}
            />

            {/* Grille de sélection statique */}
            <RadioGroup value={selectedMethod} onValueChange={setSelectedMethod} className="space-y-4">
              {filteredSections.map((section) => (
                <div key={section.id} className="animate-in fade-in slide-in-from-left-2 duration-300">
                  <h3 className="font-bold text-lg mb-2 flex items-center gap-2">
                    {section.type === 'country' && (section as any).flag}
                    {section.name}
                  </h3>
                  <div className="grid grid-cols-2 sm:grid-cols-3 gap-3">
                    {section.methods.map((method: string) => {
                      const value = section.type === 'country' ? `${(section as any).code}:${method}` : method;
                      return (
                        <div key={value}>
                          <RadioGroupItem value={value} id={value} className="peer sr-only" />
                          <Label
                            htmlFor={value}
                            className="flex flex-col items-center justify-center rounded-xl border-2 border-muted bg-popover p-4 hover:bg-accent hover:text-accent-foreground peer-data-[state=checked]:border-primary peer-data-[state=checked]:bg-primary/5 cursor-pointer transition-all h-24 text-center"
                          >
                            <span className="text-sm font-bold truncate w-full px-1">
                              {t(`depositMethod_${method.toLowerCase().replace(/\s/g, '_')}`, method)}
                            </span>
                          </Label>
                        </div>
                      );
                    })}
                  </div>
                </div>
              ))}
            </RadioGroup>

            {/* Affichage du formulaire seulement si une méthode est choisie */}
            {selectedMethod && (
              <div className="pt-6 border-t border-dashed">
                {renderForm()}
              </div>
            )}
          </div>
        </CardContent>
      </Card>

      {/* Dialogue de statut avec polling */}
      <DepositStatusDialog
        open={!!status}
        status={status}
        isPolling={isPolling}
        reference={transactionRef}
        instructions={status === 'pending' ? statusMessage : null}
        onClose={() => { setStatus(null); setTransactionRef(null); }}
        onSuccess={() => router.push('/transactions')}
        checkStatusAction={async (ref) => {
          const res = await checkDepositStatus(ref);
          return { success: res.success, status: res.status, message: res.message || '' };
        }}
      />
    </>
  );
}
