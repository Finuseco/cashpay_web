'use client';

import React from "react";
import { useForm } from "react-hook-form";
import { useTranslation } from "react-i18next";
import { Form, FormControl, FormField, FormItem, FormLabel, FormMessage } from "@/components/ui/form";
import { Input } from "@/components/ui/input";
import { Button } from "@/components/ui/button";
import type { User, Country } from '@/lib/types';
import { z } from "zod";
import { zodResolver } from "@hookform/resolvers/zod";
import { Loader2, ShieldCheck } from "lucide-react";
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "../ui/select";

const depositSchema = z.object({
  amount: z.coerce.number().min(1, "Le montant doit être supérieur à 0."),
  phoneNumber: z.string().min(9, "Le numéro de téléphone est requis."),
  currency: z.string().min(1, "Veuillez choisir une devise."),
});

export const MobileMoneyDepositForm = ({ user, country, onSubmit, isSubmitting }: { user: User | null, country: Country | null, onSubmit: (values: any) => void, isSubmitting: boolean }) => {
  const { t } = useTranslation();

  // Extraction sécurisée des données du pays avec valeurs de secours pour éviter tout crash au rendu
  const currencyCode = country?.currency_code || 'USD';
  const dialCode = country?.dial_code || '';

  const form = useForm<z.infer<typeof depositSchema>>({
    resolver: zodResolver(depositSchema),
    defaultValues: {
      amount: undefined,
      phoneNumber: user?.phone?.slice(-9) || '',
      currency: currencyCode
    },
  });

  return (
    <Form {...form}>
      <form onSubmit={form.handleSubmit(onSubmit)} className="space-y-6">
        <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
            <FormField
                control={form.control}
                name="amount"
                render={({ field }) => (
                <FormItem>
                    <FormLabel>{t('depositAmountLabel', 'Montant')}</FormLabel>
                    <FormControl>
                        <Input 
                            type="number" 
                            placeholder="0.00" 
                            {...field} 
                            value={field.value || ''} 
                            className="h-12 text-lg font-bold" 
                        />
                    </FormControl>
                    <FormMessage />
                </FormItem>
                )}
            />
             <FormField
                control={form.control}
                name="currency"
                render={({ field }) => (
                <FormItem>
                    <FormLabel>{t('depositCurrencyLabel', 'Devise')}</FormLabel>
                    <Select onValueChange={field.onChange} defaultValue={field.value}>
                        <FormControl>
                            <SelectTrigger className="h-12 font-semibold">
                                <SelectValue />
                            </SelectTrigger>
                        </FormControl>
                        <SelectContent>
                           <SelectItem value="USD">USD</SelectItem>
                           <SelectItem value="EUR">EUR</SelectItem>
                           {currencyCode !== 'USD' && currencyCode !== 'EUR' && currencyCode !== '' && (
                               <SelectItem value={currencyCode}>{currencyCode}</SelectItem>
                           )}
                        </SelectContent>
                    </Select>
                    <FormMessage />
                </FormItem>
                )}
            />
        </div>

        <FormField
            control={form.control}
            name="phoneNumber"
            render={({ field }) => (
            <FormItem>
                <FormLabel>
                    {t('depositPhoneNumberLabel', 'Numéro de téléphone pour le dépôt')}
                </FormLabel>
                <div className="relative">
                    <div className="absolute left-4 top-1/2 -translate-y-1/2 font-bold text-zinc-400">
                        {dialCode}
                    </div>
                    <FormControl>
                        <Input 
                            type="tel" 
                            placeholder="000 000 000" 
                            {...field} 
                            className="h-12 pl-16 text-lg font-mono tracking-widest" 
                        />
                    </FormControl>
                </div>
                <FormMessage />
            </FormItem>
            )}
        />
        
        <Button type="submit" variant="gradient" className="w-full h-14 text-lg font-black shadow-xl" disabled={isSubmitting}>
            {isSubmitting ? <Loader2 className="mr-2 h-5 w-5 animate-spin" /> : <ShieldCheck className="mr-2 h-5 w-5" />}
            {t('depositConfirmButton', "VALIDER L'APPROVISIONNEMENT")}
        </Button>
      </form>
    </Form>
  )
}
