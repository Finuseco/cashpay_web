'use client';

import { zodResolver } from "@hookform/resolvers/zod";
import { useForm } from "react-hook-form";
import { z } from "zod";
import { useTranslation } from "react-i18next";
import { useState, useEffect, useMemo } from "react";
import {
  Form,
  FormControl,
  FormField,
  FormItem,
  FormLabel,
  FormMessage,
} from "@/components/ui/form";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select";
import { useAlertDialog } from "@/hooks/use-alert-dialog";
import { createTransaction } from "@/lib/actions/transaction.actions";
import { getGuaranteedFxQuote, type ExchangeRate } from "@/lib/actions/exchange.actions";
import { ArrowDown, Loader2, RefreshCw, ShieldCheck } from "lucide-react";
import type { User, Currency } from '@/lib/types';
import { InputOTP, InputOTPGroup, InputOTPSlot } from "@/components/ui/input-otp";
import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogDescription, DialogFooter, DialogClose } from '../ui/dialog';
import { verifyCurrentUserPin } from "@/lib/actions/auth.actions";
import { useRouter } from 'next/navigation';
import { motion } from "framer-motion";

const formSchema = z.object({
  fromCurrency: z.string({ required_error: "Sélectionnez une devise source." }),
  toCurrency: z.string({ required_error: "Sélectionnez une devise de destination." }),
  fromAmount: z.coerce.number().min(0.01, { message: "Le montant doit être positif." }),
}).refine(data => data.fromCurrency !== data.toCurrency, {
  message: "Les devises doivent être différentes.",
  path: ["toCurrency"],
});

const pinSchema = z.object({
  pin: z.string().length(4, "Le PIN doit contenir 4 chiffres."),
});

interface ExchangeFormProps {
    user: User | null;
    currencies: Currency[];
    initialRates: ExchangeRate[];
    localCurrencyCode?: string | null;
}

export function ExchangeForm({ user, currencies, initialRates, localCurrencyCode }: ExchangeFormProps) {
  const { openAlert } = useAlertDialog();
  const router = useRouter();
  const { t } = useTranslation();
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [isFetchingRate, setIsFetchingRate] = useState(false);
  const [quote, setQuote] = useState<{ quoteId: string; toAmount: number; rate: number } | null>(null);
  const [isPinDialogOpen, setIsPinDialogOpen] = useState(false);
  const [exchangeDetails, setExchangeDetails] = useState<z.infer<typeof formSchema> | null>(null);
  
  const isFormDisabled = initialRates.length === 0;

  const form = useForm<z.infer<typeof formSchema>>({
    resolver: zodResolver(formSchema),
    defaultValues: { 
      fromAmount: undefined,
      fromCurrency: "USD",
      toCurrency: localCurrencyCode || undefined
    },
  });
  
  const pinForm = useForm<z.infer<typeof pinSchema>>({
    resolver: zodResolver(pinSchema),
    defaultValues: { pin: "" },
  });
  
  const fromCurrency = form.watch("fromCurrency");
  const toCurrency = form.watch("toCurrency");
  const fromAmount = form.watch("fromAmount");

  const availableCurrencies = useMemo(() => {
      return currencies.map(c => c.code);
  }, [currencies]);

  const handleGetQuote = async () => {
    const isValid = await form.trigger(['fromAmount', 'fromCurrency', 'toCurrency']);
    if (!isValid) return;

    setIsFetchingRate(true);
    setQuote(null);
    try {
        const result = await getGuaranteedFxQuote(fromAmount, fromCurrency, toCurrency);
        if(result.success && result.quote) {
            setQuote(result.quote);
        } else {
            openAlert({ title: "Taux indisponible", description: result.error || "Impossible de récupérer le taux actuel.", variant: 'error' });
        }
    } finally {
        setIsFetchingRate(false);
    }
  };

  const handleDetailsSubmit = (values: z.infer<typeof formSchema>) => {
    if (!quote) {
        openAlert({ title: "Calcul requis", description: "Veuillez d'abord cliquer sur le bouton de calcul pour obtenir le taux garanti.", variant: 'info' });
        return;
    }
    const fromBalance = currencies.find(c => c.code === values.fromCurrency)?.balance || '0';
    const balanceNum = parseFloat(fromBalance.replace(/,/g, ''));
    
    if (values.fromAmount > balanceNum) {
      form.setError('fromAmount', { type: 'manual', message: 'Solde insuffisant dans ce portefeuille.' });
      return;
    }
    setExchangeDetails(values);
    setIsPinDialogOpen(true);
  };
  
  const handleFinalSubmit = async (pinValues: z.infer<typeof pinSchema>) => {
    if (!user || !exchangeDetails || !quote) return;
    setIsSubmitting(true);
    
    const pinVerification = await verifyCurrentUserPin(pinValues.pin);
    if (!pinVerification.success) {
      openAlert({ variant: "error", title: "PIN Incorrect", description: pinVerification.error });
      setIsSubmitting(false);
      pinForm.reset();
      return;
    }

    const result = await createTransaction({
      user,
      typeCode: "EXCHANGE",
      amount: exchangeDetails.fromAmount,
      currency: exchangeDetails.fromCurrency,
      description: `Échange de ${exchangeDetails.fromCurrency} vers ${exchangeDetails.toCurrency}`,
      metadata: {
        toCurrency: exchangeDetails.toCurrency,
        toAmount: quote.toAmount,
        rate: quote.rate,
        quoteId: quote.quoteId,
      }
    });

    setIsSubmitting(false);
    setIsPinDialogOpen(false);

    if (result.success) {
      openAlert({
        variant: "success",
        title: "Opération réussie",
        description: `L'échange a été effectué. Vos portefeuilles ont été mis à jour.`,
        onClose: () => router.refresh()
      });
      form.reset();
      pinForm.reset();
      setQuote(null);
    } else {
      openAlert({ variant: "error", title: "Erreur", description: result.error });
    }
  }

  const userBalance = (currencies.find(c => c.code === fromCurrency)?.balance || '0.00');

  return (
    <>
    <Dialog open={isPinDialogOpen} onOpenChange={setIsPinDialogOpen}>
        <DialogContent className="bg-zinc-900 border-zinc-800 text-white">
          <DialogHeader>
            <DialogTitle>Confirmer l'opération de change</DialogTitle>
            <DialogDescription className="text-zinc-400">
              Veuillez valider le débit de votre portefeuille source.
            </DialogDescription>
          </DialogHeader>
           <Form {...pinForm}>
              <form onSubmit={pinForm.handleSubmit(handleFinalSubmit)} className="space-y-6 pt-4">
                <div className="text-center p-4 bg-muted/50 rounded-xl space-y-1">
                  <p className="text-xs text-muted-foreground uppercase font-bold tracking-widest">Résumé de la conversion</p>
                  <p className="text-lg">Dépense : <span className="font-bold">{exchangeDetails?.fromAmount.toFixed(2)} {exchangeDetails?.fromCurrency}</span></p>
                  <p className="text-xl text-primary font-black">Réception : {quote?.toAmount.toFixed(2)} {exchangeDetails?.toCurrency}</p>
                </div>
                <FormField
                  control={pinForm.control}
                  name="pin"
                  render={({ field }) => (
                    <FormItem>
                      <FormLabel className="text-center block mb-4">Saisir votre PIN CashPay</FormLabel>
                      <FormControl><div className="flex justify-center"><InputOTP maxLength={4} {...field}><InputOTPGroup><InputOTPSlot index={0} /><InputOTPSlot index={1} /><InputOTPSlot index={2} /><InputOTPSlot index={3} /></InputOTPGroup></InputOTP></div></FormControl>
                      <FormMessage />
                    </FormItem>
                  )}
                />
                <DialogFooter>
                  <Button type="submit" variant="gradient" className="w-full h-12 font-bold shadow-xl" disabled={isSubmitting}>
                    {isSubmitting ? <Loader2 className="mr-2 h-4 w-4 animate-spin" /> : <ShieldCheck className="mr-2"/>}
                    CONFIRMER L'ÉCHANGE
                  </Button>
                </DialogFooter>
              </form>
           </Form>
        </DialogContent>
    </Dialog>

    <Card className="shadow-lg border-none">
      <CardHeader>
        <CardTitle>Bureau de Change Souverain</CardTitle>
        <CardDescription>Convertissez vos fonds instantanément aux taux officiels du pays.</CardDescription>
      </CardHeader>
      <CardContent>
        <Form {...form}>
          <form onSubmit={form.handleSubmit(handleDetailsSubmit)} className="space-y-6">
          <fieldset disabled={isFormDisabled} className="space-y-6">
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4 items-end">
              <FormField
                control={form.control}
                name="fromCurrency"
                render={({ field }) => (
                  <FormItem>
                    <FormLabel>Devise source (Débit)</FormLabel>
                    <Select onValueChange={(val) => { field.onChange(val); setQuote(null); }} value={field.value}>
                      <FormControl><SelectTrigger className="h-12"><SelectValue placeholder="Choisir" /></SelectTrigger></FormControl>
                      <SelectContent>
                        {availableCurrencies.map(c => <SelectItem key={c} value={c}>{c}</SelectItem>)}
                      </SelectContent>
                    </Select>
                    <p className="text-[10px] text-muted-foreground font-bold mt-1 uppercase">Solde : {userBalance}</p>
                  </FormItem>
                )}
              />
               <FormField
                control={form.control}
                name="toCurrency"
                render={({ field }) => (
                  <FormItem>
                    <FormLabel>Vers (Réception)</FormLabel>
                    <Select onValueChange={(val) => { field.onChange(val); setQuote(null); }} value={field.value}>
                      <FormControl><SelectTrigger className="h-12"><SelectValue placeholder="Choisir" /></SelectTrigger></FormControl>
                      <SelectContent>
                        {availableCurrencies.map(c => <SelectItem key={c} value={c}>{c}</SelectItem>)}
                      </SelectContent>
                    </Select>
                  </FormItem>
                )}
              />
            </div>
             <FormField
                control={form.control}
                name="fromAmount"
                render={({ field }) => (
                  <FormItem>
                    <FormLabel>Montant à convertir</FormLabel>
                    <FormControl>
                      <Input 
                        type="number" 
                        placeholder="0.00" 
                        {...field} 
                        value={field.value || ''} 
                        className="h-14 text-2xl font-black text-center"
                        onChange={(e) => { field.onChange(e); setQuote(null); }}
                      />
                    </FormControl>
                    <FormMessage />
                  </FormItem>
                )}
              />
              
              <div className="flex flex-col items-center justify-center py-4 bg-muted/20 rounded-2xl border border-dashed">
                {isFetchingRate ? (
                    <div className="flex flex-col items-center gap-2"><Loader2 className="animate-spin text-primary" /><p className="text-[10px] font-bold uppercase">Calcul du taux garanti...</p></div>
                ) : quote ? (
                    <motion.div initial={{ opacity: 0, y: 10 }} animate={{ opacity: 1, y: 0 }} className="text-center">
                        <ArrowDown className="h-5 w-5 text-muted-foreground mx-auto mb-2" />
                        <p className="text-[10px] text-muted-foreground uppercase font-bold tracking-widest">Vous recevrez</p>
                        <p className="text-3xl font-black text-primary">{toCurrency} {quote.toAmount.toFixed(2)}</p>
                        <p className="text-[10px] text-zinc-400 mt-1 italic">Taux : 1 {fromCurrency} ≈ {quote.rate.toFixed(4)} {toCurrency}</p>
                    </motion.div>
                ) : (
                    <Button type="button" variant="outline" size="sm" onClick={handleGetQuote} className="h-10 border-primary text-primary hover:bg-primary/5">
                        <RefreshCw className="mr-2 h-4 w-4"/> CALCULER LA CONVERSION
                    </Button>
                )}
              </div>

            <Button type="submit" variant="gradient" className="w-full h-14 text-xl font-black shadow-xl" disabled={isFormDisabled || isFetchingRate || !quote}>
                VALIDER L'ÉCHANGE
            </Button>
            </fieldset>
          </form>
        </Form>
      </CardContent>
    </Card>
    </>
  );
}
