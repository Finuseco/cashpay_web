/* =========================================================
   TRANSFERT
========================================================= */

const transferSchema = z.object({
  amount: z.coerce
    .number()
    .min(0.01, "Le montant doit être positif."),

  currency: z.string({
    required_error: "Veuillez sélectionner une devise."
  }),

  pin: z.string()
    .length(4, "Le PIN à 4 chiffres est requis.")
});


const InChatTransferForm = ({
  onSubmit,
  currencies,
  currentUser
}: {
  onSubmit: (
    values: z.infer<typeof transferSchema>
  ) => void;

  currencies: Currency[];

  currentUser: User;
}) => {

  const { t } = useTranslation();

  const form = useForm<z.infer<typeof transferSchema>>({
    resolver: zodResolver(transferSchema),

    defaultValues: {
      currency: "USD",
      amount: undefined,
      pin: ''
    }
  });

  const selectedCurrencyCode =
    form.watch('currency');

  const selectedCurrency =
    currencies.find(
      c => c.code === selectedCurrencyCode
    );

  return (
    <Form {...form}>
      <form
        onSubmit={form.handleSubmit(onSubmit)}
        className="space-y-4"
      >

        <div className="grid grid-cols-2 gap-4">

          <FormField
            control={form.control}
            name="amount"
            render={({ field }) => (
              <FormItem>

                <FormLabel>
                  {t('amountLabel')}
                </FormLabel>

                <FormControl>
                  <Input
                    type="number"
                    {...field}
                    value={field.value || ''}
                  />
                </FormControl>

                <FormMessage />

              </FormItem>
            )}
          />

          <FormField
            control={form.control}
            name="currency"
            render={({ field }) => (
              <FormItem>

                <FormLabel>
                  {t('currencyLabel')}
                </FormLabel>

                <Select
                  onValueChange={field.onChange}
                  defaultValue={field.value}
                >

                  <FormControl>
                    <SelectTrigger>
                      <SelectValue />
                    </SelectTrigger>
                  </FormControl>

                  <SelectContent>

                    {currencies.map(c => (
                      <SelectItem
                        key={c.code}
                        value={c.code}
                      >
                        {c.code} (Solde: {c.balance})
                      </SelectItem>
                    ))}

                  </SelectContent>

                </Select>

              </FormItem>
            )}
          />

        </div>

        {selectedCurrency && (
          <p className="text-xs text-muted-foreground">
            Solde disponible : {selectedCurrency.balance}{' '}
            {selectedCurrency.code}
          </p>
        )}

        <FormField
          control={form.control}
          name="pin"
          render={({ field }) => (
            <FormItem>

              <FormLabel>
                {t('yourPinLabel')}
              </FormLabel>

              <FormControl>

                <div className="flex justify-center">

                  <InputOTP
                    maxLength={4}
                    {...field}
                  >

                    <InputOTPGroup>

                      <InputOTPSlot index={0} />
                      <InputOTPSlot index={1} />
                      <InputOTPSlot index={2} />
                      <InputOTPSlot index={3} />

                    </InputOTPGroup>

                  </InputOTP>

                </div>

              </FormControl>

              <FormMessage />

            </FormItem>
          )}
        />

        <Button
          type="submit"
          variant="gradient"
          className="w-full"
        >
          {t('proposeTransferButton')}
        </Button>

      </form>
    </Form>
  );
};


/* =========================================================
   LECTEUR MESSAGE VOCAL
========================================================= */

const VoiceMessagePlayer = ({
  message,
  senderAvatar
}: {
  message: Message;
  senderAvatar?: string;
}) => {

  const audioRef =
    useRef<HTMLAudioElement>(null);

  const [isPlaying, setIsPlaying] =
    useState(false);

  const [progress, setProgress] =
    useState(0);

  const togglePlay = () => {

    if (audioRef.current) {

      if (isPlaying) {
        audioRef.current.pause();
      } else {
        audioRef.current.play();
      }

      setIsPlaying(!isPlaying);
    }
  };

  const handleTimeUpdate = () => {

    if (audioRef.current) {

      setProgress(
        (audioRef.current.currentTime /
          audioRef.current.duration) * 100
      );
    }
  };

  const handleEnded = () => {
    setIsPlaying(false);
    setProgress(0);
  };

  let fileDetails: any = null;

  try {
    fileDetails = message.metadata
      ? typeof message.metadata === 'string'
        ? JSON.parse(message.metadata)
        : message.metadata
      : null;
  } catch {
    fileDetails = null;
  }

  return (
    <div className="flex items-center gap-2 p-2">

      <audio
        ref={audioRef}
        src={fileDetails?.fileUrl}
        onTimeUpdate={handleTimeUpdate}
        onEnded={handleEnded}
        preload="metadata"
      />

      <Avatar className="h-10 w-10 shrink-0">

        <AvatarImage src={senderAvatar} />

        <AvatarFallback>
          ?
        </AvatarFallback>

      </Avatar>

      <Button
        variant="ghost"
        size="icon"
        className="h-10 w-10 shrink-0"
        onClick={togglePlay}
      >
        {isPlaying
          ? <StopCircle className="h-6 w-6" />
          : <PlayCircle className="h-6 w-6" />
        }
      </Button>

      <div className="w-full h-1 bg-zinc-600 rounded-full relative">

        <div
          className="h-1 bg-white rounded-full"
          style={{
            width: `${progress}%`
          }}
        />

        <div
          className="absolute h-3 w-3 bg-white rounded-full -top-1"
          style={{
            left: `calc(${progress}% - 6px)`
          }}
        />

      </div>

    </div>
  );
};


/* =========================================================
   PRODUIT
========================================================= */

const ProductCardMessage = ({
  metadata
}: {
  metadata: string;
}) => {

  try {

    const product = JSON.parse(metadata);

    return (
      <Card className="overflow-hidden border-zinc-700 bg-zinc-800 text-white w-64 shadow-xl">

        <div className="relative aspect-square">

          <NextImage
            src={product.image}
            alt={product.name}
            fill
            className="object-cover"
          />

          <div className="absolute top-2 left-2 bg-primary text-white text-[10px] font-black px-2 py-0.5 rounded uppercase tracking-tighter">
            JoJo Shopping
          </div>

        </div>

        <CardContent className="p-3 space-y-2">

          <h4 className="font-bold text-sm line-clamp-1">
            {product.name}
          </h4>

          <p className="text-primary font-bold text-lg">
            ${Number(product.price || 0).toFixed(2)}
          </p>

          <Button
            asChild
            variant="gradient"
            className="w-full h-9 text-xs font-bold rounded-full"
          >
            <Link
              href={`/shopping/${product.productId}`}
            >
              <ShoppingCart className="mr-2 h-3.5 w-3.5" />
              Commander
            </Link>
          </Button>

        </CardContent>

      </Card>
    );

  } catch {

    return (
      <div className="p-4 text-destructive bg-red-500/10 rounded">
        Erreur chargement produit
      </div>
    );
  }
};


/* =========================================================
   MESSAGE BUBBLE
========================================================= */

const MessageBubble = ({
  message,
  currentUser,
  sender,
  onDeleteMessage,
  onForward,
  onImageClick
}: {
  message: Message;
  currentUser: User;
  sender?: User;
  onDeleteMessage: (messageId: string) => void;
  onForward: (message: Message) => void;
  onImageClick: (url: string) => void;
}) => {

  const { t } = useTranslation();
  const { toast } = useToast();

  const isSentByCurrentUser =
    message.senderId === currentUser.id;

  let transferData: any = null;

  let fileData: {
    fileUrl: string;
    fileName?: string;
    imageId?: string;
  } | null = null;

  const isAudio =
    message.type === 'audio';

  const isDocument =
    message.type === 'doc';

  const isImage =
    message.type === 'image';

  const isProduct =
    message.type === 'product';

  if (
    message.content?.startsWith('{')
  ) {

    try {

      const parsedContent =
        JSON.parse(message.content);

      if (
        parsedContent &&
        parsedContent.type ===
          'in_chat_transfer'
      ) {
        transferData = parsedContent;
      }

    } catch {}
  }

  if (message.metadata) {

    try {

      fileData =
        typeof message.metadata === 'string'
          ? JSON.parse(message.metadata)
          : message.metadata;

    } catch {}
  }

  const MessageStatus = () => {

    if (
      !isSentByCurrentUser ||
      !message.status
    ) {
      return null;
    }

    if (message.status === 'read') {
      return (
        <CheckCheck className="h-4 w-4 text-blue-400" />
      );
    }

    if (message.status === 'delivered') {
      return (
        <CheckCheck className="h-4 w-4 text-zinc-400" />
      );
    }

    return (
      <Check className="h-4 w-4 text-zinc-400" />
    );
  };

  const handleCopy = () => {

    navigator.clipboard.writeText(
      message.content || ''
    );

    toast({
      title: t('toastCopied'),
      description: t('messageCopied')
    });
  };

  const handleDownload = () => {

    if (!fileData?.fileUrl) return;

    const link =
      document.createElement('a');

    link.href =
      fileData.fileUrl;

    link.download =
      fileData.fileName || 'file';

    document.body.appendChild(link);

    link.click();

    document.body.removeChild(link);
  };

  return (
    <div
      className={cn(
        "flex w-full items-end gap-2 group",
        isSentByCurrentUser
          ? "justify-end"
          : "justify-start"
      )}
    >

      <div
        className={cn(
            "flex items-center",
            isSentByCurrentUser && "order-1"
        )}
      >

        <DropdownMenu>

          <DropdownMenuTrigger asChild>

            <Button
              variant="ghost"
              size="icon"
              className="
                h-6
                w-6
                opacity-0
                group-hover:opacity-100
                data-[state=open]:opacity-100
                shrink-0
                text-zinc-400
              "
            >
              <MoreVertical className="h-4 w-4" />
            </Button>

          </DropdownMenuTrigger>

          <DropdownMenuContent
            className="
              bg-zinc-800
              border-zinc-700
              text-white
            "
          >

            {!isAudio &&
              !isImage &&
              !isDocument &&
              !isProduct && (

              <DropdownMenuItem
                className="focus:bg-zinc-700"
                onClick={handleCopy}
              >
                <Copy className="mr-2 h-4 w-4" />
                {t('copyButton')}
              </DropdownMenuItem>

            )}

            {(isImage || isDocument) && (

              <DropdownMenuItem
                className="focus:bg-zinc-700"
                onClick={handleDownload}
              >
                <Download className="mr-2 h-4 w-4" />
                Télécharger
              </DropdownMenuItem>

            )}

            <DropdownMenuItem
              className="focus:bg-zinc-700"
              onClick={() =>
                onForward(message)
              }
            >
              <Forward className="mr-2 h-4 w-4" />
              Transférer
            </DropdownMenuItem>

            {isSentByCurrentUser && (

              <DropdownMenuItem
                className="focus:bg-zinc-700"
                onClick={() =>
                  onDeleteMessage(message.id)
                }
              >
                <Trash2 className="mr-2 h-4 w-4" />
                {t('deleteButton')}
              </DropdownMenuItem>

            )}

          </DropdownMenuContent>

        </DropdownMenu>

      </div>

      <div
        className={cn(
          "rounded-lg shadow-sm relative",

          isSentByCurrentUser
            ? "bg-[#005c4b] text-white rounded-br-none"
            : "bg-[#2a3942] text-white rounded-bl-none",

          isProduct
            ? "p-1"
            : "p-2 min-w-[100px] max-w-[75%]",

          (isImage || isAudio) &&
            "p-1",

          transferData &&
            "bg-zinc-800 border border-zinc-700"
        )}
      >

        {isProduct ? (

          <ProductCardMessage
            metadata={message.metadata!}
          />

        ) : isDocument &&
          fileData?.fileUrl ? (

          <a
            href={fileData.fileUrl}
            target="_blank"
            rel="noopener noreferrer"
            className="
              flex
              items-center
              gap-2
              bg-black/20
              rounded-md
              p-2
            "
          >

            <FileText className="h-8 w-8 text-white" />

            <div className="flex-1">

              <p className="font-semibold text-sm line-clamp-1">
                {fileData.fileName}
              </p>

              <p className="text-xs text-zinc-300">
                {t('documentLabel')}
              </p>

            </div>

          </a>

        ) : isImage &&
          fileData?.fileUrl ? (

          <div className="flex flex-col gap-1">

            <div
              className="
                relative
                group/img
                cursor-pointer
              "
              onClick={() =>
                onImageClick(
                  fileData!.fileUrl
                )
              }
            >

              <NextImage
                src={fileData.fileUrl}
                alt="image sent"
                width={250}
                height={250}
                className="
                  rounded-md
                  object-cover
                "
              />

              <div
                className="
                  absolute
                  inset-0
                  bg-black/20
                  opacity-0
                  group-hover/img:opacity-100
                  transition-opacity
                  flex
                  items-center
                  justify-center
                  rounded-md
                "
              >
                <Maximize2 className="h-8 w-8 text-white/80" />
              </div>

            </div>

            <div
              className="
                flex
                justify-around
                items-center
                py-1
                border-t
                border-white/10
                mt-1
              "
            >

              <Button
                variant="ghost"
                size="icon"
                className="
                  h-7
                  w-7
                  text-white/60
                  hover:text-white
                "
                onClick={() => {}}
              >
                <ThumbsUp className="h-4 w-4" />
              </Button>

              <Button
                variant="ghost"
                size="icon"
                className="
                  h-7
                  w-7
                  text-white/60
                  hover:text-white
                "
                onClick={handleDownload}
              >
                <Download className="h-4 w-4" />
              </Button>

              <Button
                variant="ghost"
                size="icon"
                className="
                  h-7
                  w-7
                  text-white/60
                  hover:text-white
                "
                onClick={() =>
                  onForward(message)
                }
              >
                <Forward className="h-4 w-4" />
              </Button>

            </div>

          </div>

        ) : isAudio ? (

          <VoiceMessagePlayer
            message={message}
            senderAvatar={
              sender?.profile_photo || undefined
            }
          />

        ) : transferData ? (

          <p className="whitespace-pre-wrap text-sm p-2 italic">
            {transferData.text}
          </p>

        ) : (

          <p className="whitespace-pre-wrap text-sm p-2">
            {message.content}
          </p>

        )}

        <div
          className="
            flex
            items-center
            justify-end
            gap-1.5
            text-xs
            text-green-300/60
            mt-1
            self-end
            px-1.5
            pb-1
          "
        >

          <span>
            {format(
              new Date(message.timestamp),
              'HH:mm'
            )}
         'use client';

